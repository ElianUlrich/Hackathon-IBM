{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/project.schema.json",
  "title": "PinPilot Project File",
  "description": "Schema for the project.json file exported by the PinPilot web app.",
  "type": "object",
  "required": ["board", "components", "buses", "app"],
  "additionalProperties": false,
  "properties": {

    "board": {
      "type": "string",
      "const": "esp32dev",
      "description": "PlatformIO board identifier. Always esp32dev for PinPilot v1."
    },

    "components": {
      "type": "array",
      "description": "List of component instances placed in the project.",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["instance_id", "catalog_id", "pin_mapping"],
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Unique instance identifier, e.g. bme280_1"
          },
          "catalog_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "ID of the catalog entry this instance references, e.g. bme280"
          },
          "pin_mapping": {
            "type": "object",
            "description": "Maps component pin roles to ESP32 GPIO numbers (as integers).",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 39
            }
          },
          "i2c_address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127,
            "description": "7-bit I2C address used by this instance. Required for i2c components."
          },
          "bus_id": {
            "type": "string",
            "description": "Reference to a bus defined in the buses object, e.g. i2c0 or spi0."
          },
          "parameters": {
            "type": "object",
            "description": "Optional component-specific parameters (e.g. resolution, mode).",
            "additionalProperties": true
          }
        }
      }
    },

    "buses": {
      "type": "object",
      "description": "Bus configurations. Keys are bus IDs (e.g. i2c0, spi0, uart2).",
      "additionalProperties": false,
      "properties": {
        "i2c0": {
          "type": "object",
          "required": ["sda", "scl"],
          "additionalProperties": false,
          "properties": {
            "sda":       { "type": "integer", "minimum": 0, "maximum": 39, "description": "GPIO number for I2C SDA" },
            "scl":       { "type": "integer", "minimum": 0, "maximum": 39, "description": "GPIO number for I2C SCL" },
            "frequency": { "type": "integer", "default": 400000, "description": "I2C clock frequency in Hz" }
          }
        },
        "spi0": {
          "type": "object",
          "required": ["mosi", "miso", "sck"],
          "additionalProperties": false,
          "properties": {
            "mosi":      { "type": "integer", "minimum": 0, "maximum": 39 },
            "miso":      { "type": "integer", "minimum": 0, "maximum": 39 },
            "sck":       { "type": "integer", "minimum": 0, "maximum": 39 },
            "frequency": { "type": "integer", "default": 40000000, "description": "SPI clock frequency in Hz" }
          }
        },
        "uart2": {
          "type": "object",
          "required": ["rx", "tx"],
          "additionalProperties": false,
          "properties": {
            "rx":   { "type": "integer", "minimum": 0, "maximum": 39 },
            "tx":   { "type": "integer", "minimum": 0, "maximum": 39 },
            "baud": { "type": "integer", "default": 9600 }
          }
        }
      }
    },

    "screen": {
      "type": "object",
      "description": "Optional display configuration. Omit if no display is used.",
      "required": ["instance_id", "driver", "widgets"],
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "instance_id of the display component in the components array"
        },
        "driver": {
          "type": "string",
          "enum": ["ssd1306", "ili9341", "st7789"],
          "description": "Display driver type"
        },
        "widgets": {
          "type": "array",
          "description": "List of widgets to render on the display.",
          "items": {
            "type": "object",
            "required": ["id", "type", "binding"],
            "additionalProperties": false,
            "properties": {
              "id":      { "type": "string", "description": "Unique widget ID within this screen" },
              "type":    { "type": "string", "enum": ["label", "value", "bar", "arc", "chart"] },
              "binding": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                "description": "Data binding in format instance_id.measurement_name, e.g. bme280_1.temperature"
              },
              "label":   { "type": "string", "description": "Display label text" },
              "unit":    { "type": "string", "description": "Unit string shown next to the value" },
              "x":       { "type": "integer", "description": "X position in pixels (LVGL/U8g2 coordinates)" },
              "y":       { "type": "integer", "description": "Y position in pixels" },
              "width":   { "type": "integer" },
              "height":  { "type": "integer" },
              "min":     { "type": "number", "description": "Minimum value for bar/arc/chart widgets" },
              "max":     { "type": "number", "description": "Maximum value for bar/arc/chart widgets" }
            }
          }
        }
      }
    },

    "app": {
      "type": "object",
      "required": ["wifi"],
      "additionalProperties": false,
      "properties": {
        "wifi": {
          "type": "boolean",
          "description": "Whether WiFi is enabled. When true, ADC2 pins cannot be used for analog sensors."
        },
        "serial_logging": {
          "type": "boolean",
          "default": true,
          "description": "Enable Serial output at 115200 baud with startup summary."
        },
        "ota": {
          "type": "boolean",
          "default": false,
          "description": "OTA update support. Out of scope for PinPilot v1."
        }
      }
    }

  }
}
