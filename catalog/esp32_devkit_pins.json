    "input": true, "output": true,
    "adc1": false, "adc2": true,
    "dac": false, "touch": true,
    "pullup": true, "pulldown": true,
    "flags": ["strapping"],
    "notes": "Strapping pin: must be HIGH at boot (pulled high by internal pull-up). Boot fails if held LOW."
